    <y>280</y>
    <width>120</width>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_2</name>
    <pv_name>CAM:StartScan</pv_name>
    <x>60</x>
    <y>370</y>
    <width>130</width>
    <off_label>Press to start</off_label>
    <on_label>Start</on_label>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_3</name>

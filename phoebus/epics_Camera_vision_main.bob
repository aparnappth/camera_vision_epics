<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <background_color>
    <color red="153" green="153" blue="153">
    </color>
  </background_color>
  <grid_visible>false</grid_visible>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <class>Label</class>
    <text>Camera Vision</text>
    <x>220</x>
    <y>10</y>
    <width>240</width>
    <height>40</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <text>Command</text>
    <x>30</x>
    <y>200</y>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Combo Box</name>
    <pv_name>CAM:CameraCommand</pv_name>
    <x>140</x>
    <y>190</y>
    <items>
      <item> Start</item>
      <item>Stop</item>
      <item>Acquire</item>
      <item>Close</item>
    </items>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_4</name>
    <text>Set Exposure</text>
    <x>310</x>
    <y>300</y>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>CAM:SetExposure</pv_name>
    <x>440</x>
    <y>300</y>
    <width>150</width>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_5</name>
    <text>Current exposure</text>
    <x>310</x>
    <y>340</y>
    <width>150</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_1</name>
    <pv_name>CAM:GetExposure</pv_name>
    <x>440</x>
    <y>340</y>
    <width>150</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_6</name>
    <text>Set Gain</text>
    <x>30</x>
    <y>300</y>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry_1</name>
    <pv_name>CAM:SetGain</pv_name>
    <x>150</x>
    <y>300</y>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_7</name>
    <text>Current Gain</text>
    <x>30</x>
    <y>340</y>
    <width>150</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_2</name>
    <pv_name>CAM:GetGain</pv_name>
    <x>150</x>
    <y>340</y>
    <width>110</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_8</name>
    <text>Auto exposure</text>
    <x>30</x>
    <y>380</y>
    <width>120</width>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button</name>
    <pv_name>CAM:SetAutoExposure</pv_name>
    <x>150</x>
    <y>380</y>
    <off_label>Disable</off_label>
    <on_label>Enable</on_label>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_9</name>
    <text>Latest JPEG file path</text>
    <x>30</x>
    <y>440</y>
    <width>120</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_3</name>
    <pv_name>CAM:GetLatestImagePath</pv_name>
    <x>150</x>
    <y>440</y>
    <width>160</width>
    <format>6</format>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_10</name>
    <text>Latest JSON Metadata file path</text>
    <x>30</x>
    <y>490</y>
    <width>120</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update_4</name>
    <pv_name>CAM:GetLatestMetadataPath</pv_name>
    <x>150</x>
    <y>490</y>
    <width>170</width>
    <format>6</format>
  </widget>
  <widget type="image" version="2.0.0">
    <name>Image_1</name>
    <pv_name>pva://CAM:Image</pv_name>
    <x>340</x>
    <y>60</y>
    <width>240</width>
    <height>190</height>
    <color_bar>
      <visible>false</visible>
      <bar_size>40</bar_size>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </color_bar>
    <x_axis>
      <visible>false</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </x_axis>
    <y_axis>
      <visible>false</visible>
      <title>Y</title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </y_axis>
    <color_mode>3</color_mode>
    <unsigned>true</unsigned>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button_1</name>
    <pv_name>CAM:ScanEnable</pv_name>
    <x>500</x>
    <y>390</y>
    <width>90</width>
    <off_label>Disable</off_label>
    <off_color>
      <color name="Off" red="60" green="100" blue="60">
      </color>
    </off_color>
    <on_label>Enable</on_label>
  </widget>
  <widget type="databrowser" version="2.0.0">
    <name>Data Browser</name>
    <x>760</x>
    <y>420</y>
    <width>1</width>
    <height>1</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>scan eposure</name>
    <actions execute_as_one="true">
      <action type="open_display">
        <description>Open Display</description>
        <file>epics_Camera_vision_scan_exposure.bob</file>
        <target>window</target>
      </action>
      <action type="write_pv">
        <description>Exposure Scan</description>
        <pv_name>CAM:ScanType</pv_name>
        <value>0</value>
      </action>
    </actions>
    <pv_name>CAM:ScanType</pv_name>
    <text>Exposure_Scan</text>
    <x>440</x>
    <y>440</y>
    <width>150</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>scan eposure_1</name>
    <actions execute_as_one="true">
      <action type="open_display">
        <description>Open Display</description>
        <file>epics_Camera_vision_scan_gain.bob</file>
        <target>window</target>
      </action>
      <action type="write_pv">
        <description>Gain  Scan</description>
        <pv_name>CAM:ScanType</pv_name>
        <value>1</value>
      </action>
    </actions>
    <pv_name>CAM:ScanType</pv_name>
    <text>Gain_Scan</text>
    <x>440</x>
    <y>480</y>
    <width>150</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="ellipse" version="2.0.0">
    <name>Ellipse</name>
    <x>100</x>
    <y>80</y>
    <width>140</width>
    <height>60</height>
    <line_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </line_color>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>CAM:GetStatus</pv_name>
    <x>100</x>
    <y>80</y>
    <width>140</width>
    <height>60</height>
    <font>
      <font family="Lucida Bright" style="BOLD" size="18.0">
      </font>
    </font>
    <background_color>
      <color name="Transparent" red="255" green="255" blue="255" alpha="0">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>Scan</text>
    <x>440</x>
    <y>400</y>
    <width>70</width>
    <height>30</height>
  </widget>
</display>
